{
  "name": "between-us",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:hub": "node scripts/hub-room-scenarios.mjs",
    "preview": "vite preview",
    "deploy:cloud": "npm run build && npx wrangler@4 deploy --config workers/cloud/wrangler.toml",
    "quiz:index": "node scripts/rebuild-quiz-index.mjs",
    "photos:thumbs": "node scripts/make-photo-thumbs.mjs",
    "photos:r2": "node scripts/migrate-photos-to-r2.mjs",
    "photos:r2:dry": "node scripts/migrate-photos-to-r2.mjs --dry",
    "mp:seed": "npm run seed --prefix apps/miniprogram",
    "mp:build": "npm run build:weapp --prefix apps/miniprogram",
    "mp:dev": "npm run dev:weapp --prefix apps/miniprogram"
  },
  "dependencies": {
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/zcool-xiaowei": "^5.3.0",
    "date-fns": "^4.4.0",
    "marked": "^18.2.1",
    "peerjs": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "peer": "^1.0.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
